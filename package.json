{
  "name": "@moonlinetravel/vue-kit",
  "version": "0.0.0",
  "description": "Shared Vue 3 utilities, HTTP client and overridable inputs for Moonline apps",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonlineTravel/vue-kit.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "rm -rf dist && vite build && vue-tsc -p tsconfig.build.json && cp src/theme.css dist/theme.css",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "format": "prettier --write src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "sh smoke/run.sh",
    "format:check": "prettier --check src tests"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "~10.7.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
